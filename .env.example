# Production AWS Secrets Manager integration
# The backend reads this JSON secret during startup and exports each JSON key
# (including OPENAI_API_KEY) as a process environment variable.
AWS_BACKEND_ENV_SECRET_NAME=roundready/prod/backend-env
AWS_REGION=ap-south-1

# Select the LLM provider. The provider key is loaded from the AWS secret.
LLM_PROVIDER=openai
